{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", ".firebaserc", "**/.*", "**/node_modules/**",
      "scripts/**", "logs/**", "README.md"
    ],
    "cleanUrls": true,
    "headers": [
      { "source": "data/@(bulletin|history|alerts).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
